---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div>
			<p class="footer-brand">{site.name}</p>
			<p class="footer-tagline">{site.tagline}.</p>
		</div>
		<div>
			<h2 class="footer-title">Explora</h2>
			<ul>
				<li><a href="/perros">Alimento para perros</a></li>
				<li><a href="/gatos">Alimento para gatos</a></li>
				<li><a href="/carrito">Mi carrito</a></li>
			</ul>
		</div>
		<div>
			<h2 class="footer-title">Pedidos</h2>
			<p>Arma tu pedido en el carrito y confírmalo con nosotros por WhatsApp.</p>
		</div>
	</div>
	<p class="copyright">© {year} {site.name}. Todos los derechos reservados.</p>
</footer>

<style>
	.site-footer {
		background: var(--color-ink);
		color: rgb(255 255 255 / 0.75);
		padding-top: 3.5rem;
		margin-top: 2rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
		padding-bottom: 2.5rem;
	}

	.footer-brand {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-white);
		margin: 0 0 0.5rem;
	}

	.footer-tagline,
	.footer-grid p {
		margin: 0;
	}

	.footer-title {
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--color-white);
		margin-bottom: 0.75rem;
	}

	.footer-grid ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	.footer-grid a {
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-grid a:hover {
		color: var(--color-accent);
	}

	.copyright {
		text-align: center;
		font-size: 0.85rem;
		border-top: 1px solid rgb(255 255 255 / 0.12);
		padding-block: 1.25rem;
		margin: 0;
	}
</style>
