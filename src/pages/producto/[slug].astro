---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatPrice } from '../../lib/format';
import { products, speciesInfo, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const related = products
  .filter((item) => item.species === product.species && item.slug !== product.slug)
  .slice(0, 3);
const categoryUrl = `/${product.species}`;
---

<BaseLayout title={product.name} description={product.shortDescription}>
	<nav class="breadcrumb container" aria-label="Ruta de navegación">
		<a href="/">Inicio</a> / <a href={categoryUrl}>{speciesInfo[product.species].label}</a> / <span>{product.name}</span>
	</nav>

	<section class="container detail">
		<div class="detail__media">
			<img src={product.image} alt={product.name} width="600" height="600" />
		</div>

		<div class="detail__info">
			<p class="detail__weight">{product.weight}</p>
			<h1>{product.name}</h1>
			<p class="detail__price">{formatPrice(product.price)}</p>
			<p class="detail__desc">{product.description}</p>

			<ul class="benefits">
				{product.benefits.map((benefit) => <li>{benefit}</li>)}
			</ul>

			<div class="detail__actions">
				<button type="button" class="btn btn-accent" data-add-to-cart={product.slug}>Agregar al carrito</button>
				<a class="btn btn-outline" href="/carrito">Ver carrito</a>
			</div>
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="section">
				<div class="container">
					<div class="section__header">
						<h2>También te puede interesar</h2>
					</div>
					<div class="grid">
						{related.map((item) => <ProductCard product={item} />)}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.breadcrumb {
		padding-top: 1.5rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.breadcrumb a {
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--color-primary);
	}

	.detail {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		padding-block: 2rem 3rem;
	}

	.detail__media img {
		width: 100%;
		border-radius: 2rem;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.detail__weight {
		margin: 0 0 0.5rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		color: var(--color-primary-strong);
	}

	.detail h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
	}

	.detail__price {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-accent-strong);
		margin: 0 0 1rem;
	}

	.detail__desc {
		color: var(--color-muted);
		font-size: 1.05rem;
	}

	.benefits {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 2rem;
		display: grid;
		gap: 0.6rem;
	}

	.benefits li {
		position: relative;
		padding-left: 2rem;
	}

	.benefits li::before {
		content: '✓';
		position: absolute;
		left: 0;
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.15rem;
		border-radius: 50%;
		background: var(--color-primary-soft);
		color: var(--color-primary-strong);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.detail__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	@media (max-width: 760px) {
		.detail {
			grid-template-columns: 1fr;
		}
	}
</style>
