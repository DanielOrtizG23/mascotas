---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
	<section class="section not-found">
		<div class="container">
			<p class="code">404</p>
			<h1>Esta página se fue de paseo</h1>
			<p>No encontramos lo que buscas. Puedes volver al inicio o explorar nuestro catálogo.</p>
			<div class="actions">
				<a class="btn btn-primary" href="/">Ir al inicio</a>
				<a class="btn btn-outline" href="/perros">Ver productos</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		text-align: center;
	}

	.code {
		font-family: var(--font-display);
		font-size: clamp(4rem, 12vw, 7rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1;
		margin: 0;
	}

	.not-found p {
		color: var(--color-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.9rem;
		margin-top: 2rem;
	}
</style>
